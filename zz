<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Shoply — Modern E‑commerce Demo</title>
  <meta name="description" content="Modern e-commerce front-end demo inspired by Trendyol. Responsive layout, product grid, filters, cart with localStorage." />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <header class="site-header" role="banner">
    <div class="container header-inner">
      <a href="#" class="logo" aria-label="Shoply home">
        <svg width="36" height="36" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M3 6h2l1 9a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3l1-9h2" opacity=".9"/><circle cx="10" cy="20" r="1" /><circle cx="18" cy="20" r="1"/></svg>
        <span class="logo-text">Shoply</span>
      </a>

      <form id="searchForm" class="search" role="search" aria-label="Site search">
        <label for="searchInput" class="visually-hidden">Search products</label>
        <input id="searchInput" name="q" type="search" placeholder="Search for products, brands..." autocomplete="off" aria-autocomplete="list" />
        <button type="submit" aria-label="Search">Search</button>
      </form>

      <nav class="header-actions" aria-label="User actions">
        <button id="categoriesToggle" class="icon-btn" aria-expanded="false" aria-controls="categoryBar" title="Categories">☰</button>
        <button id="accountBtn" class="icon-btn" title="Account" aria-label="Account"><span aria-hidden="true">👤</span></button>
        <button id="cartBtn" class="icon-btn" aria-label="Open cart" aria-haspopup="dialog" title="Cart">
          <span aria-hidden="true">🛒</span>
          <span id="cartCount" class="cart-count" aria-live="polite">0</span>
        </button>
        <button id="navToggle" class="icon-btn nav-toggle" aria-expanded="false" aria-controls="mainNav" title="Toggle navigation">☰</button>
      </nav>
    </div>

    <div id="categoryBar" class="category-bar" aria-hidden="true">
      <div class="container category-list" role="navigation" aria-label="Product categories">
        <!-- categories rendered by JS -->
      </div>
    </div>
  </header>

  <main class="site-main" id="main" role="main">
    <section class="hero container" aria-label="Promotions">
      <div class="carousel" id="heroCarousel" tabindex="0" aria-roledescription="carousel" aria-label="Site promotions">
        <div class="slides" data-current="0">
          <div class="slide" data-index="0" aria-hidden="false">
            <picture>
              <source media="(min-width:800px)" srcset="https://picsum.photos/1600/500?random=1">
              <img data-src="https://picsum.photos/900/350?random=1" alt="Summer style collection" class="lazy" />
            </picture>
            <div class="slide-content">
              <h2>Summer Picks — Up to 50% off</h2>
              <p>Refresh your wardrobe with trending styles and exclusive deals.</p>
              <a class="btn" href="#">Shop Summer</a>
            </div>
          </div>

          <div class="slide" data-index="1" aria-hidden="true">
            <picture>
              <source media="(min-width:800px)" srcset="https://picsum.photos/1600/500?random=2">
              <img data-src="https://picsum.photos/900/350?random=2" alt="Home & Living deals" class="lazy" />
            </picture>
            <div class="slide-content">
              <h2>Home & Living — New Arrivals</h2>
              <p>Decor, kitchenware and more to refresh your space.</p>
              <a class="btn" href="#">Explore Home</a>
            </div>
          </div>

          <div class="slide" data-index="2" aria-hidden="true">
            <picture>
              <source media="(min-width:800px)" srcset="https://picsum.photos/1600/500?random=3">
              <img data-src="https://picsum.photos/900/350?random=3" alt="Sports gear special" class="lazy" />
            </picture>
            <div class="slide-content">
              <h2>Sports & Outdoors</h2>
              <p>Gear up with top brands and seasonal discounts.</p>
              <a class="btn" href="#">Get Ready</a>
            </div>
          </div>
        </div>

        <button class="carousel-btn prev" aria-label="Previous slide">‹</button>
        <button class="carousel-btn next" aria-label="Next slide">›</button>
        <div class="carousel-dots" role="tablist" aria-label="Slide selectors"></div>
      </div>
    </section>

    <section class="container layout">
      <aside class="filters" aria-label="Product filters">
        <h3>Filters</h3>
        <div class="filter-group">
          <label for="categoryFilter">Category</label>
          <select id="categoryFilter" aria-label="Filter by category">
            <option value="">All</option>
          </select>
        </div>

        <div class="filter-group">
          <label for="priceMin">Price range</label>
          <div class="price-range">
            <input id="priceMin" type="number" min="0" placeholder="Min" />
            <span>—</span>
            <input id="priceMax" type="number" min="0" placeholder="Max" />
          </div>
        </div>

        <div class="filter-group">
          <label for="sortBy">Sort by</label>
          <select id="sortBy" aria-label="Sort products">
            <option value="popular">Most popular</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="newest">Newest</option>
          </select>
        </div>

        <button id="clearFilters" class="btn small">Clear filters</button>
      </aside>

      <section class="products" aria-label="Products">
        <div class="products-bar">
          <h2 id="resultsLabel">Featured Products</h2>
          <div class="products-actions">
            <label for="viewMode" class="visually-hidden">Change view</label>
            <select id="viewMode" aria-label="View mode">
              <option value="grid">Grid</option>
              <option value="list">List</option>
            </select>
          </div>
        </div>

        <div id="productGrid" class="product-grid" aria-live="polite">
          <!-- product cards rendered by JS -->
        </div>

        <div class="pagination" id="pagination" aria-hidden="true">
          <button id="prevPage" class="btn outline" disabled>Previous</button>
          <button id="nextPage" class="btn">Next</button>
        </div>
      </section>
    </section>
  </main>

  <div id="cartDrawer" class="cart-drawer" role="dialog" aria-label="Shopping cart" aria-hidden="true">
    <div class="cart-header">
      <h3>Your Cart</h3>
      <button id="closeCart" class="icon-btn" aria-label="Close cart">✕</button>
    </div>
    <div id="cartItems" class="cart-items" aria-live="polite">
      <!-- items -->
    </div>
    <div class="cart-footer">
      <div class="cart-summary">
        <span>Total</span>
        <strong id="cartTotal">₺0</strong>
      </div>
      <button id="checkoutBtn" class="btn">Checkout</button>
    </div>
  </div>

  <div id="overlay" class="overlay" hidden></div>

  <footer class="site-footer" role="contentinfo">
    <div class="container footer-inner">
      <p>© <span id="year"></span> Shoply — Demo e‑commerce interface.</p>
      <nav aria-label="Footer">
        <a href="#">Help</a>
        <a href="#">Returns</a>
        <a href="#">Contact</a>
      </nav>
    </div>
  </footer>

  <template id="productTemplate">
    <article class="product-card" tabindex="0">
      <div class="media">
        <img class="product-img lazy" alt="" data-src="">
        <button class="quick-view" aria-label="Quick view product">Quick view</button>
      </div>
      <div class="meta">
        <h3 class="title"></h3>
        <div class="price-wrap">
          <span class="price"></span>
          <button class="add-cart btn small">Add</button>
        </div>
      </div>
    </article>
  </template>

  <script src="script.js" defer></script>
</body>
</html>
